# Supabase PostgreSQL. Copy both values from
# Supabase → Project Settings → Database → Connection string.
# DATABASE_URL is the transaction pooler (port 6543). Add ?pgbouncer=true
# DIRECT_URL is the direct connection (port 5432), used by migrations.
# Do not commit the real password. Do not put these values in the browser.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Used to sign login sessions. Replace with a long random string before use.
# Example: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="replace-with-a-long-random-string"

# API port. The office server and the browser use this same port after npm start.
PORT=3001

# Leave unset. The server then accepts this computer and other devices on the private office network.
# HOST="127.0.0.1"

# Leave unset for the normal internal http:// address.
# Set true only when the app is served over HTTPS.
# COOKIE_SECURE="false"

# Vite development origin. Used only by npm run dev.
CLIENT_ORIGIN="http://localhost:5173"

NODE_ENV="development"

# Leave unset on the office computer. Do not put the administrator password in this file.
# CMH_BIND="0.0.0.0"

# Vercel project settings, not this file. Set all of them there.
# DATABASE_URL, DIRECT_URL and JWT_SECRET use the same formats as above.
# ADMIN_NAME, ADMIN_EMAIL and ADMIN_PASSWORD create the first administrator only
# when that email is absent. Leave them empty to skip. They never create employees,
# services or payments. Do not commit the password.
